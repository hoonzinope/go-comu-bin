{{define "page"}}
<section class="page">
  {{if .Message}}<div class="banner">{{.Message}}</div>{{end}}
  {{if eq .Kind "feed"}}
    {{template "page-feed" .}}
  {{else if eq .Kind "board"}}
    {{template "page-board" .}}
  {{else if eq .Kind "tag"}}
    {{template "page-tag" .}}
  {{else if eq .Kind "search"}}
    {{template "page-search" .}}
  {{else if eq .Kind "post"}}
    {{template "page-post" .}}
  {{else if eq .Kind "compose"}}
    {{template "page-compose" .}}
  {{else if eq .Kind "login"}}
    {{template "page-login" .}}
  {{else if eq .Kind "signup"}}
    {{template "page-signup" .}}
  {{else if eq .Kind "verify-email"}}
    {{template "page-verify-email" .}}
  {{else if eq .Kind "reset-password"}}
    {{template "page-reset-password" .}}
  {{else if eq .Kind "me"}}
    {{template "page-me" .}}
  {{else if eq .Kind "notifications"}}
    {{template "page-notifications" .}}
  {{else if eq .Kind "admin-reports"}}
    {{template "page-admin-reports" .}}
  {{else if eq .Kind "admin-outbox"}}
    {{template "page-admin-outbox" .}}
  {{else if eq .Kind "admin-boards"}}
    {{template "page-admin-boards" .}}
  {{else if eq .Kind "me-upgrade"}}
    {{template "page-me-upgrade" .}}
  {{else if eq .Kind "admin-board-edit"}}
    {{template "page-admin-board-edit" .}}
  {{else if eq .Kind "admin-snapshot"}}
    {{template "page-admin-snapshot" .}}
  {{else if eq .Kind "admin-suspension"}}
    {{template "page-admin-suspension" .}}
  {{else if eq .Kind "error"}}
    {{template "page-error" .}}
  {{else}}
    {{template "empty-state" (dict "Compact" true "Icon" "dashboard" "Eyebrow" "Empty surface" "Title" "Nothing to render" "Body" "Choose a feed, board, or account surface from the community map." )}}
  {{end}}
</section>
{{end}}
