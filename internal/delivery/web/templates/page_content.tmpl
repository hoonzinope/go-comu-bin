{{define "page-feed"}}
<div class="feed-intro panel">
  <div class="feed-intro-copy">
    <div class="page-eyebrow">Community feed</div>
    <h1>Feed</h1>
    <p>Read the newest conversations first, then narrow by board, tag, or search.</p>
  </div>
  {{template "page-feed-tabs" .}}
</div>
{{template "page-feed-list" .}}
{{end}}

{{define "page-feed-tabs"}}
<div class="tab-strip">
  <a class="tab {{if or (eq .SortValue "") (eq .SortValue "hot")}}is-active{{end}}" href="{{pageURL .ListBaseURL "sort" "hot"}}">Hot</a>
  <a class="tab {{if eq .SortValue "latest"}}is-active{{end}}" href="{{pageURL .ListBaseURL "sort" "latest"}}">Latest</a>
  <a class="tab {{if eq .SortValue "top"}}is-active{{end}}" href="{{pageURL .ListBaseURL "sort" "top"}}">Top</a>
</div>
{{end}}

{{define "page-feed-list"}}
{{template "page-feed-items" .}}
{{end}}

{{define "page-feed-items"}}
{{if and .Feed (gt (len .Feed.Posts) 0)}}
  <div class="stack">
    {{range .Feed.Posts}}
    {{template "post-summary" (dict "Shell" $.Shell "Post" .)}}
    {{end}}
  </div>
  {{template "pagination" .}}
{{else}}
  <div class="panel empty community-empty">
    <div class="empty-eyebrow">No posts yet</div>
    <p>Be the first to start the discussion.</p>
    {{if and $.Shell.IsAuthenticated $.Shell.ComposeURL}}
    <a class="button button-primary empty-cta" href="{{$.Shell.ComposeURL}}">+ Write the first post</a>
    {{end}}
  </div>
{{end}}
{{end}}

{{define "page-board"}}
<div class="page-heading">
  <h1>{{if .BoardName}}{{.BoardName}}{{else}}{{boardName .Shell.BoardMap .BoardUUID}}{{end}}</h1>
  <p>Board discussion feed.</p>
</div>
{{template "page-feed-tabs" (dict "Shell" .Shell "ListBaseURL" (printf "/boards/%s" .BoardUUID) "ListLimit" .ListLimit "Pagination" .Pagination "Feed" .Feed "SortValue" .SortValue "WindowValue" .WindowValue "BoardUUID" .BoardUUID)}}
{{template "page-feed-items" (dict "Shell" .Shell "ListBaseURL" (printf "/boards/%s" .BoardUUID) "ListLimit" .ListLimit "Pagination" .Pagination "Feed" .Feed "SortValue" .SortValue "WindowValue" .WindowValue "BoardUUID" .BoardUUID)}}
{{end}}

{{define "page-tag"}}
<div class="page-heading">
  <h1>#{{.TagName}}</h1>
  <p>Tag discussion feed.</p>
</div>
{{template "page-feed-tabs" (dict "Shell" .Shell "ListBaseURL" (printf "/tags/%s" .TagName) "ListLimit" .ListLimit "Pagination" .Pagination "Feed" .Feed "SortValue" .SortValue "WindowValue" .WindowValue "TagName" .TagName)}}
{{template "page-feed-items" (dict "Shell" .Shell "ListBaseURL" (printf "/tags/%s" .TagName) "ListLimit" .ListLimit "Pagination" .Pagination "Feed" .Feed "SortValue" .SortValue "WindowValue" .WindowValue "TagName" .TagName)}}
{{end}}

{{define "page-search"}}
<div class="page-heading">
  <h1>Search</h1>
  <p>{{if .Query}}Results for "{{.Query}}"{{else}}Enter a term to scan posts, boards, and tags{{end}}</p>
</div>
{{if .Query}}
<div class="tab-strip">
  <a class="tab {{if or (eq .SortValue "") (eq .SortValue "hot")}}is-active{{end}}" href="{{pageURL .ListBaseURL "q" .Query "sort" "hot"}}">Hot</a>
  <a class="tab {{if eq .SortValue "latest"}}is-active{{end}}" href="{{pageURL .ListBaseURL "q" .Query "sort" "latest"}}">Latest</a>
  <a class="tab {{if eq .SortValue "top"}}is-active{{end}}" href="{{pageURL .ListBaseURL "q" .Query "sort" "top"}}">Top</a>
</div>
{{end}}
{{template "page-search-items" .}}
{{end}}

{{define "page-search-items"}}
{{if .Feed}}
  {{if gt (len .Feed.Posts) 0}}
    <div class="stack">
      {{range .Feed.Posts}}
      {{template "post-summary" (dict "Shell" $.Shell "Post" .)}}
      {{end}}
    </div>
    {{template "pagination" .}}
  {{else}}
    <div class="panel empty community-empty">
      <div class="empty-eyebrow">No results yet</div>
      <p>Try a broader term or browse the full feed.</p>
      <a class="button empty-cta" href="/">Browse all posts</a>
    </div>
  {{end}}
{{else}}
  <div class="panel empty community-empty">
    <div class="empty-eyebrow">Search ready</div>
    <p>Enter a term to scan posts, boards, and tags.</p>
  </div>
{{end}}
{{end}}

{{define "page-post"}}
<div class="post-layout page-main">
  <article class="panel post-main">
    <header class="post-header">
      <div class="post-eyebrow">
        <a class="chip" href="/boards/{{.PostDetail.Post.BoardUUID}}">{{boardName $.Shell.BoardMap .PostDetail.Post.BoardUUID}}</a>
        <span class="post-uuid">#{{shortUUID .PostDetail.Post.UUID}}</span>
      </div>
      <h1 class="post-title">{{.PostDetail.Post.Title}}</h1>
      <div class="post-meta">
        <div class="post-byline">
          <span>@{{shortUUID .PostDetail.Post.AuthorUUID}}</span>
          <span>{{formatTime .PostDetail.Post.CreatedAt}}</span>
          <span>{{if .Comments}}{{len .Comments.Comments}}{{else}}0{{end}} comments</span>
          <span>{{len .PostDetail.Attachments}} attachments</span>
          <span>{{len .PostDetail.Reactions}} reactions</span>
        </div>
      </div>
    </header>
    {{if .PostDetail.Tags}}
    <div class="chip-row">
      {{range .PostDetail.Tags}}<a class="chip" href="/tags/{{.Name}}">{{.Name}}</a>{{end}}
    </div>
    {{end}}
    <div class="markdown">{{renderMarkdown .PostDetail.Post.Content}}</div>
    <section class="post-actions">
      <div class="section-title">Actions</div>
      <div class="button-row">
        {{if canInteract .Shell}}
        <form action="/posts/{{.PostUUID}}/reactions" method="post">
          <input type="hidden" name="_csrf" value="{{.Shell.CSRFToken}}">
          <input type="hidden" name="reaction_type" value="like">
          <button class="button {{if reactionActive .PostDetail.MyReactionType "like"}}button-primary is-active{{end}}" type="submit">▲ Upvote</button>
        </form>
        <form action="/posts/{{.PostUUID}}/reactions" method="post">
          <input type="hidden" name="_csrf" value="{{.Shell.CSRFToken}}">
          <input type="hidden" name="reaction_type" value="dislike">
          <button class="button {{if reactionActive .PostDetail.MyReactionType "dislike"}}button-primary is-active{{end}}" type="submit">▼ Downvote</button>
        </form>
        <form action="/posts/{{.PostUUID}}/reactions" method="post">
          <input type="hidden" name="_csrf" value="{{.Shell.CSRFToken}}">
          <input type="hidden" name="_method" value="delete">
          <button class="button button-ghost" type="submit">Remove reaction</button>
        </form>
        {{else}}
        <a class="button button-primary" href="/login?redirect={{queryEscape (printf "/posts/%s" .PostUUID)}}">Login to react</a>
        {{end}}
      </div>
      <div class="button-row">
        <a class="button" href="#comments">Comments</a>
        {{if .PostDetail.Attachments}}<a class="button" href="#attachments">Attachments</a>{{end}}
      </div>
      {{if and .Shell.CurrentUser (eq .Shell.CurrentUser.UUID .PostDetail.Post.AuthorUUID)}}
      <div class="button-row">
        <a class="button" href="/posts/{{.PostUUID}}/edit">Edit</a>
        <form class="inline-form" action="/posts/{{.PostUUID}}/delete" method="post">
          <input type="hidden" name="_csrf" value="{{.Shell.CSRFToken}}">
          <button class="button button-danger" type="submit" onclick="return confirm('Delete this post?')">Delete</button>
        </form>
      </div>
      {{end}}
      <details class="secondary-action report-toggle">
        <summary class="button button-ghost">Report</summary>
        <form action="/reports" method="post" class="comment-report-form">
          <input type="hidden" name="_csrf" value="{{.Shell.CSRFToken}}">
          <input type="hidden" name="target_type" value="post">
          <input type="hidden" name="target_uuid" value="{{.PostUUID}}">
          <input type="hidden" name="redirect" value="/posts/{{.PostUUID}}">
          <label for="post-report-reason">Reason</label>
          <select id="post-report-reason" name="reason_code">
            <option value="spam">Spam</option>
            <option value="abuse">Abuse</option>
            <option value="sexual">Sexual</option>
            <option value="violence">Violence</option>
            <option value="illegal">Illegal</option>
            <option value="other">Other</option>
          </select>
          <label for="post-report-detail">Details</label>
          <textarea id="post-report-detail" name="reason_detail" rows="2" placeholder="Optional detail"></textarea>
          <button class="button" type="submit">Report</button>
        </form>
      </details>
    </section>
    {{if .PostDetail.Attachments}}
    <section id="attachments">
      <div class="section-title">Attachments</div>
      <div class="stack">
        {{range .PostDetail.Attachments}}
        <div class="panel attachment-row">
          <div>
            {{ $attachmentPostUUID := .PostUUID }}{{ if eq $attachmentPostUUID "" }}{{ $attachmentPostUUID = $.PostDetail.Post.UUID }}{{ end }}
            <div class="table-title"><a href="{{printf "/api/v1/posts/%s/attachments/%s/file" $attachmentPostUUID .UUID}}">{{.FileName}}</a></div>
            <div class="table-sub">{{.ContentType}} · {{.SizeBytes}} bytes</div>
            <div class="chip-row">
              <a class="chip" href="{{printf "/api/v1/posts/%s/attachments/%s/file" $attachmentPostUUID .UUID}}">Open file</a>
              {{if or $.Shell.IsAdmin (and $.Shell.CurrentUser (eq $.Shell.CurrentUser.UUID $.PostDetail.Post.AuthorUUID))}}
              <a class="chip" href="{{if .PreviewURL}}{{.PreviewURL}}{{else}}{{printf "/api/v1/posts/%s/attachments/%s/preview" $attachmentPostUUID .UUID}}{{end}}">Preview</a>
              {{end}}
            </div>
          </div>
          <span class="chip">{{shortUUID .UUID}}</span>
        </div>
        {{end}}
      </div>
    </section>
    {{end}}
    <section id="comments">
      <div class="section-title">Comments <span class="section-count">{{if .Comments}}{{len .Comments.Comments}}{{else}}0{{end}}</span></div>
      {{if canInteract .Shell}}
      <form class="panel form comment-form" action="/posts/{{.PostUUID}}/comments" method="post">
        <input type="hidden" name="_csrf" value="{{.Shell.CSRFToken}}">
        <label for="comment-content">Write a comment</label>
        <textarea id="comment-content" name="content" rows="5" placeholder="Share your reply"></textarea>
        <button class="button button-primary" type="submit">Comment</button>
      </form>
      {{else}}
      <div class="panel form comment-form comment-cta">
        <div class="section-title">Write a comment</div>
        <p>Sign in to join the discussion before replying.</p>
        <a class="button button-primary" href="/login?redirect={{queryEscape (printf "/posts/%s" .PostUUID)}}">Login to comment</a>
      </div>
      {{end}}
      {{if .Comments}}
        <div class="stack">
          {{range .Comments.Comments}}
          <div class="panel comment" x-data="{editing:false}">
            <div class="meta-row"><span>@{{shortUUID .AuthorUUID}}</span><span>{{formatTime .CreatedAt}}</span>
              {{if and $.Shell.CurrentUser (eq $.Shell.CurrentUser.UUID .AuthorUUID)}}
              <span class="button-row" style="margin-left:auto">
                <button class="button" type="button" @click="editing=!editing">Edit</button>
                <form class="inline-form" action="/comments/{{.UUID}}/delete" method="post">
                  <input type="hidden" name="_csrf" value="{{$.Shell.CSRFToken}}">
                  <input type="hidden" name="post_uuid" value="{{$.PostUUID}}">
                  <button class="button button-danger" type="submit" onclick="return confirm('Delete comment?')">Delete</button>
                </form>
              </span>
              {{end}}
            </div>
            <p x-show="!editing">{{.Content}}</p>
            {{if canInteract $.Shell}}
            <div class="button-row">
              <form action="/comments/{{.UUID}}/reactions" method="post">
                <input type="hidden" name="_csrf" value="{{$.Shell.CSRFToken}}">
                <input type="hidden" name="post_uuid" value="{{$.PostUUID}}">
                <input type="hidden" name="reaction_type" value="like">
                <button class="button button-primary" type="submit">▲ Upvote</button>
              </form>
              <form action="/comments/{{.UUID}}/reactions" method="post">
                <input type="hidden" name="_csrf" value="{{$.Shell.CSRFToken}}">
                <input type="hidden" name="post_uuid" value="{{$.PostUUID}}">
                <input type="hidden" name="reaction_type" value="dislike">
                <button class="button" type="submit">▼ Downvote</button>
              </form>
              <form action="/comments/{{.UUID}}/reactions" method="post">
                <input type="hidden" name="_csrf" value="{{$.Shell.CSRFToken}}">
                <input type="hidden" name="post_uuid" value="{{$.PostUUID}}">
                <input type="hidden" name="_method" value="delete">
                <button class="button button-ghost" type="submit">Remove</button>
              </form>
            </div>
            <details class="secondary-action report-toggle">
              <summary class="button button-ghost">Report comment</summary>
              <form action="/reports" method="post" class="comment-report-form">
                <input type="hidden" name="_csrf" value="{{$.Shell.CSRFToken}}">
                <input type="hidden" name="target_type" value="comment">
                <input type="hidden" name="target_uuid" value="{{.UUID}}">
                <input type="hidden" name="redirect" value="/posts/{{$.PostUUID}}">
                <label for="comment-report-reason-{{.UUID}}">Reason</label>
                <select id="comment-report-reason-{{.UUID}}" name="reason_code">
                  <option value="spam">Spam</option>
                  <option value="abuse">Abuse</option>
                  <option value="sexual">Sexual</option>
                  <option value="violence">Violence</option>
                  <option value="illegal">Illegal</option>
                  <option value="other">Other</option>
                </select>
                <label for="comment-report-detail-{{.UUID}}">Details</label>
                <textarea id="comment-report-detail-{{.UUID}}" name="reason_detail" rows="2" placeholder="Optional detail"></textarea>
                <button class="button" type="submit">Report comment</button>
              </form>
            </details>
            {{else}}
            <div class="meta-row">
              <a class="button" href="/login?redirect={{queryEscape (printf "/posts/%s" $.PostUUID)}}">Login to react</a>
            </div>
            {{end}}
            <form x-show="editing" action="/comments/{{.UUID}}" method="post">
              <input type="hidden" name="_csrf" value="{{$.Shell.CSRFToken}}">
              <input type="hidden" name="post_uuid" value="{{$.PostUUID}}">
              <label for="comment-edit-{{.UUID}}">Edit comment</label>
              <textarea id="comment-edit-{{.UUID}}" name="content" rows="3">{{.Content}}</textarea>
              <div class="button-row">
                <button class="button button-primary" type="submit">Save</button>
                <button class="button" type="button" @click="editing=false">Cancel</button>
              </div>
            </form>
          </div>
          {{end}}
        </div>
        {{if and .Comments.HasMore .Comments.NextCursor}}
        <div class="pagination">
          <a class="button button-primary" href="{{pageURL (printf "/posts/%s" .PostUUID) "comment_limit" .Comments.Limit "comment_cursor" (cursorValue .Comments.NextCursor)}}">Load more comments</a>
        </div>
        {{end}}
      {{else}}
        <div class="empty">No comments yet.</div>
      {{end}}
    </section>
  </article>
</div>
{{end}}

{{define "page-compose"}}
<div class="page-heading">
  <h1>{{if eq .EditMode "edit"}}Edit draft{{else if eq .EditMode "draft"}}New draft{{else}}New post{{end}}</h1>
  <p>{{if .BoardName}}{{.BoardName}}{{else}}{{.BoardUUID}}{{end}}</p>
</div>
<div class="compose-layout page-main">
  <aside class="panel compose-sidebar">
    <div class="section-title">Workspace</div>
    <div class="meta-list">
      <div class="meta-item">
        <span>Board</span>
        <strong>{{boardName $.Shell.BoardMap .BoardUUID}}</strong>
        <small>{{.BoardUUID}}</small>
      </div>
      <div class="meta-item">
        <span>Mode</span>
        <strong>{{if eq .EditMode "edit"}}Draft edit{{else if eq .EditMode "draft"}}Save draft{{else}}Publish now{{end}}</strong>
        <small>{{if eq .EditMode "edit"}}Update an existing draft{{else if eq .EditMode "draft"}}Keep working before publish{{else}}Create a live post{{end}}</small>
      </div>
      <div class="meta-item">
        <span>Access</span>
        <strong>Public</strong>
        <small>Visible on the board feed.</small>
      </div>
      <div class="meta-item">
        <span>Guidance</span>
        <strong>Keep it structured</strong>
        <small>Use short paragraphs, tags, and markdown headings.</small>
      </div>
    </div>
    <div class="section-title">Checklist</div>
    <div class="stack">
      <div class="chip">Title set</div>
      <div class="chip">Tags reviewed</div>
      <div class="chip">Content ready</div>
    </div>
  </aside>
  <form class="panel form compose-main" action="{{if eq .EditMode "edit"}}/posts/{{.PostUUID}}{{else if eq .EditMode "draft"}}/boards/{{.BoardUUID}}/posts/drafts{{else}}/boards/{{.BoardUUID}}/posts{{end}}" method="post">
    <input type="hidden" name="_csrf" value="{{.Shell.CSRFToken}}">
    <div class="section-title">Content</div>
    <label for="compose-title">Title</label>
    <input id="compose-title" type="text" name="title" value="{{.TitleInput}}" placeholder="Post title">
    <label for="compose-tags">Tags</label>
    <input id="compose-tags" type="text" name="tags" value="{{.TagsInput}}" placeholder="go, ui, roadmap">
    <label for="compose-content">Content</label>
    <textarea id="compose-content" name="content" rows="18" placeholder="Write markdown">{{.ContentInput}}</textarea>
    <div class="button-row">
      {{if eq .EditMode "edit"}}
        <button class="button button-primary" type="submit">Update draft</button>
        <button class="button" type="submit" formaction="/posts/{{.PostUUID}}/publish">Publish</button>
      {{else if eq .EditMode "draft"}}
        <button class="button button-primary" type="submit">Save draft</button>
      {{else}}
        <button class="button button-primary" type="submit">Publish</button>
      {{end}}
    </div>
  </form>
</div>
{{end}}
